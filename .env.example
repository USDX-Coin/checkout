# Base URL backend USDX (endpoint mint v2). Origin harus diizinkan CORS backend
# (`CORS_ORIGINS`). dev: https://api-dev.usdx.co.id ; prod: https://api.usdx.co.id
NEXT_PUBLIC_API_BASE_URL=https://api-dev.usdx.co.id

# URL `app` consumer — tujuan redirect saat sesi tak valid (code handoff invalid/
# kedaluwarsa/terpakai, atau token sesi 401). Auth checkout = tukar one-time `#code=`
# handoff dari `app` → session token (USDX-378). Isi per-env di Netlify UI
# (mis. https://app.usdx.co.id). Kosong di localhost → fallback `router.back()`.
NEXT_PUBLIC_APP_URL=

# DEMO ONLY: konfirmasi pembayaran disimulasikan (PAID → "menunggu approval") supaya demo
# jalan tanpa provider bayar sungguhan. Tetap JANGAN di-set di prod — tapi flag ini SENDIRI
# tidak cukup untuk menyalakannya: kode hanya menghormatinya kalau NEXT_PUBLIC_API_BASE_URL
# menunjuk host backend non-prod yang terdaftar (localhost / 127.0.0.1 / [::1] / 0.0.0.0 /
# api-dev.usdx.co.id — lihat src/lib/env.ts). Diarahkan ke https://api.usdx.co.id, atau ke
# host apa pun di luar daftar itu, demo MATI walau nilainya "true".
NEXT_PUBLIC_DEMO_AUTOCOMPLETE=true
