# Base URL backend USDX (endpoint mint v2). Diset per environment.
# dev:     https://usdx-backend-development.up.railway.app
# staging/prod: idealnya https://api.usdx.co.id (lihat USDX-222 — cross-subdomain cookie)
NEXT_PUBLIC_API_BASE_URL=https://usdx-backend-development.up.railway.app

# Origin repo `app` — dipakai untuk link "Lihat Riwayat" → /history setelah order COMPLETED.
# Opsional: kalau kosong, tombol Riwayat disembunyikan. Prod: https://app.usdx.co.id
# (sesuaikan domain final app saat sudah fix).
NEXT_PUBLIC_APP_URL=
